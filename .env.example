APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database locale par défaut
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Supabase / PostgreSQL sur Vercel
# Colle ici l'URL fournie par Supabase depuis le panneau "Connect"
# Exemple direct:
# DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Exemple pooler transaction pour serverless:
# DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DB_CONNECTION=pgsql
# DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY=
VITE_REVERB_APP_SECRET=
VITE_REVERB_APP_ID=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# ── Pusher / Reverb (production) ──────────────────────────
# Si tu veux de l'echo temps réel en production, renseigne ces variables.
# Sinon, garde `BROADCAST_CONNECTION=log` pour éviter les erreurs de bootstrap.
VITE_BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Render deployment ──────────────────────────────────────
# When deploying on Render, set these via the Render dashboard or render.yaml:
#   CONTAINER_ROLE=web  (for the main Laravel app)
#   CONTAINER_ROLE=reverb (for the Reverb WebSocket server)
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-service.onrender.com
#   APP_KEY= (generate with `php artisan key:generate`)
#   DB_CONNECTION=pgsql
#   DB_URL= (Supabase Transaction Pooler URL with ?sslmode=require)
#   SESSION_DRIVER=cookie
#   CACHE_STORE=array
#   QUEUE_CONNECTION=sync
#   BROADCAST_CONNECTION=reverb
#   FILESYSTEM_DISK=local
#   LOG_CHANNEL=stderr
#   LOG_LEVEL=error
#
#   # Reverb variables (already configured in render.yaml)
#   REVERB_APP_ID="unipod_reverb_id"
#   REVERB_APP_KEY="unipod_reverb_key"
#   REVERB_APP_SECRET= (generate securely)
#   REVERB_HOST=your-reverb-service.onrender.com
#   REVERB_PORT=443
#   REVERB_SCHEME=https
#   VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
#   VITE_REVERB_HOST="${REVERB_HOST}"
#   VITE_REVERB_PORT="${REVERB_PORT}"
#   VITE_REVERB_SCHEME="${REVERB_SCHEME}"
